rules_version = '2';
service cloud.firestore { match /databases/{d}/documents {
  function admin() { return request.auth != null && request.auth.token.email == 'ADMIN_EMAIL_HERE'; }
  match /downloads/{id} { allow create: if request.resource.data.keys().hasOnly(['platform','type','quality','createdAt']); allow read: if admin(); }
  match /stats/{id} { allow read: if admin(); allow create, update: if request.resource.data.keys().hasOnly(['day','count']); }
  match /ads/{id} { allow read: if true; allow write: if admin(); }
  match /content/{id} { allow read: if true; allow write: if admin(); }
} }
